// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "ssh_connections": [
        {
            "host": "192.168.1.9",
            "username": "arr",
            "args": [],
            "projects": [
                {
                    "paths": [
                        "/home/arr"
                    ]
                }
            ]
        }
    ],
    "edit_predictions": {
        "open_ai_compatible_api": {
            "api_url": "",
        },
    },
    "languages": {
        "JSONC": {
            "colorize_brackets": true,
        },
        "JSON": {
            "colorize_brackets": true,
        },
    },
    "cli_default_open_behavior": "new_window",
    "collaboration_panel": {
        "dock": "left",
    },
    "agent": {
        "sidebar_side": "right",
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "diagnostics": {
        "inline": {
            "enabled": false,
        },
    },
    "agent_servers": {
        "codex-acp": {
            "type": "registry",
        },
        "cursor": {
            "type": "registry",
        },
    },
    "ui_font_family": ".ZedSans",
    "buffer_font_family": ".ZedMono",
    "icon_theme": "Material Icon Theme",
    "calls": {
        "mute_on_join": true,
    },
    "tab_size": 4,
    "git_panel": {
        "dock": "left",
        "tree_view": true,
        "show_count_badge": true,
        "file_icons": true,
        "folder_icons": true,
        "group_by": "staging"
    },
    "project_panel": {
        "dock": "left",
        "auto_fold_dirs": false,
        "entry_spacing": "standard",
        "hide_root": true,
        "scrollbar": {
            "show": "never",
        },
        "indent_guides": {
            "show": "never",
        },
        "git_status": true,
        "git_status_indicator": true,
    },
    "outline_panel": {
        "dock": "left",
        "scrollbar": {
            "show": "never",
        },
        "indent_guides": {
            "show": "never",
        },
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "base_keymap": "VSCode",
    "ui_font_size": 17.0,
    "buffer_font_size": 15.0,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "ultraViolet",
    },
    "tabs": {
        "file_icons": true,
    },
    "file_finder": {
        "modal_max_width": "medium",
    },
    "gutter": {
        "min_line_number_digits": 3,
    },
    "minimap": {
        "show": "auto",
    },
    "indent_guides": {
        "enabled": false,
    },
    "drag_and_drop_selection": {
        "enabled": false,
    },
    "show_whitespaces": "none",
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "close_on_file_delete": true,
    "theme_overrides": {
        "Tokyo Night": {
            "syntax": {
                "comment": {
                    "font_style": "italic",
                },
                "comment.doc": {
                    "font_style": "italic",
                },
            },
        },
    },
    "double_click_in_multibuffer": "open",
    "semantic_tokens": "combined",
    "completion_menu_item_kind": "symbol",
}
