{{- $host := index .hosts .chezmoi.hostname -}}
# =========================================================
# Required by configs (shell, editor, prompt, etc.)
# =========================================================

brew "bat"        # cat alias, fzf preview, MANPAGER
brew "chezmoi"    # this dotfiles manager
brew "curl"       # newer than system curl
brew "eza"        # ls/ll/la/tree aliases
brew "fd"         # preferred find alternative, fzf file listing
brew "fzf"        # fuzzy finder widgets
brew "lf"         # file manager function in aliases
brew "neovim"     # vim alias
brew "proto"      # toolchain activate in .zshrc
brew "ripgrep"    # grep alias
brew "rtk"        # token-efficient shell proxy for coding agents
brew "starship"   # prompt
brew "tmux"       # terminal multiplexer (~/.config/tmux)
brew "zoxide"     # cd alias
cask "zed"        # $EDITOR / $VISUAL
brew "direnv"     # direnv

# =========================================================
# Dev tools
# =========================================================

brew "gh"         # GitHub CLI (~/.config/gh)
brew "git"        # newer than system git
cask "claude-code" # Claude Code CLI
cask "codex"      # Codex CLI and T3 Code provider
cask "cursor"     # editor and coding agent
cask "antigravity-cli" # Antigravity CLI (agy), Google's Gemini CLI replacement

# =========================================================
# Apps
# =========================================================

tap "ardia-browser/tap"
cask "ardia"      # Arc/Dia-style Chromium; agent skills via run_onchange
cask "1password"
cask "1password-cli"
cask "discord"
cask "docker-desktop"
cask "ghostty"
cask "google-chrome"
cask "raycast"
cask "rectangle"
cask "spotify"
{{ if hasKey $host.t3 "existing_app" -}}
# Keep an existing T3 Code installation so its updater can continue managing it.
cask {{ $host.t3.cask | quote }} unless File.directory?({{ $host.t3.existing_app | quote }}) &&
  !File.directory?(File.join(ENV.fetch("HOMEBREW_PREFIX"), "Caskroom", {{ $host.t3.cask | quote }}))
{{ else -}}
cask {{ $host.t3.cask | quote }}
{{ end -}}
