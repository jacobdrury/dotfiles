{{- $hosts := dict
      .hosts.air (dict
        "fontSize" 14
        "windowHeight" 20
        "windowWidth" 120
        "workingDirectory" "/Users/jacob/Dev"
      )
      .hosts.pro (dict
        "fontSize" 16
        "windowHeight" 30
        "windowWidth" 154
        "workingDirectory" "/Users/jacobdrury/Dev"
      )
}}
{{- if not (hasKey $hosts .chezmoi.hostname) -}}
{{-   fail (printf "unknown hostname %q — add it to the hosts map in config.tmpl" .chezmoi.hostname) }}
{{- end -}}
{{- $cfg := index $hosts .chezmoi.hostname -}}
# Font
font-size = {{ $cfg.fontSize }}

# Cursor
cursor-style-blink = false

# Window
window-height = {{ $cfg.windowHeight }}
window-width = {{ $cfg.windowWidth }}
window-padding-balance = true
working-directory = {{ $cfg.workingDirectory }}
window-inherit-working-directory = true

# Theme
theme = tokyonight

# MacOS
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
macos-auto-secure-input = true
