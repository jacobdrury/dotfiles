{
  "file_types": {
    "Git Config": [
      "**/dot_gitconfig.tmpl"
    ],
    "Git Ignore": [
      "**/.chezmoiignore",
      "**/dot_gitignore"
    ],
    "ini": [
      "**/ghostty/config.tmpl"
    ],
    "JSONC": [
      "**/*.json.tmpl"
    ],
    "Markdown": [
      "**/*.md.tmpl"
    ],
    "Ruby": [
      "**/Brewfile"
    ],
    "Shell Script": [
      "**/*.sh.tmpl",
      "**/*.zsh.tmpl",
      "**/dot_zprofile",
      "**/dot_zshenv",
      "**/dot_zshrc.tmpl",
      "**/zshenv"
    ],
    "TOML": [
      "**/*.toml.tmpl",
      "**/dot_prototools"
    ]
  }
}
